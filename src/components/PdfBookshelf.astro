---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  domain: string;
}

const { domain } = Astro.props;
const dirPath = path.join(process.cwd(), 'public', 'study-files', domain);

interface PdfItem {
  name: string;
  title: string;
  size: string;
  url: string;
  viewerUrl: string;
}

let files: PdfItem[] = [];

if (fs.existsSync(dirPath)) {
  const rawFiles = fs.readdirSync(dirPath).filter((f: string) => f.toLowerCase().endsWith('.pdf'));
  const rawBase = import.meta.env.BASE_URL || '/';
  const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

  files = rawFiles.map((file: string) => {
    const filePath = path.join(dirPath, file);
    const stats = fs.statSync(filePath);
    const sizeInKb = (stats.size / 1024).toFixed(1);
    const sizeStr = stats.size > 1024 * 1024 
      ? `${(stats.size / (1024 * 1024)).toFixed(1)} MB` 
      : `${sizeInKb} KB`;

    const cleanTitle = file
      .replace(/\.pdf$/i, '')
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (char) => char.toUpperCase());

    const fileUrl = `${base}/study-files/${domain}/${file}`;
    const viewerUrl = `${base}/pdfjs/web/viewer.html?file=${encodeURIComponent(fileUrl)}#view=FitH`;

    return {
      name: file,
      title: cleanTitle,
      size: sizeStr,
      url: fileUrl,
      viewerUrl,
    };
  });
}
---

<div class="bookshelf">
  {files.length === 0 ? (
    <p class="empty">No PDFs found.</p>
  ) : (
    <div class="grid">
      {files.map((pdf) => (
        <div class="card">
          <div class="card-top">
            <span class="size">{pdf.size}</span>
          </div>

          <h3 class="title">{pdf.title}</h3>

          <div class="actions">
            <a href={pdf.viewerUrl} target="_blank" rel="noopener noreferrer" class="read-btn">
              Read ↗
            </a>
            <a href={pdf.url} download class="dl-btn">
              Download
            </a>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .bookshelf {
    margin: 1.5rem 0;
  }

  .empty {
    padding: 2rem;
    text-align: center;
    color: var(--sl-color-gray-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg-sidebar);
    gap: 1rem;
  }

  .card-top {
    display: flex;
    justify-content: flex-end;
  }

  .size {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .title {
    margin: 0 !important;
    font-size: 1.1rem !important;
    font-weight: 600 !important;
    color: var(--sl-color-text) !important;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
  }

  .read-btn {
    flex: 1;
    text-align: center;
    padding: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-text-invert) !important;
    background: var(--sl-color-accent);
    border-radius: 6px;
    text-decoration: none !important;
  }

  .dl-btn {
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    color: var(--sl-color-text) !important;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    text-decoration: none !important;
  }

  .read-btn:hover, .dl-btn:hover {
    filter: brightness(1.1);
  }
</style>
