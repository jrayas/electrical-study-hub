---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  domain: string;
}

const { domain } = Astro.props;
const dirPath = path.join(process.cwd(), 'public', 'study-files', domain);

interface PdfItem {
  name: string;
  title: string;
  size: string;
  url: string;
  viewerUrl: string;
  hypothesisUrl: string;
}

let files: PdfItem[] = [];

if (fs.existsSync(dirPath)) {
  const rawFiles = fs.readdirSync(dirPath).filter((f: string) => f.toLowerCase().endsWith('.pdf'));
  const rawBase = import.meta.env.BASE_URL || '/';
  const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

  files = rawFiles.map((file: string) => {
    const filePath = path.join(dirPath, file);
    const stats = fs.statSync(filePath);
    const sizeInKb = (stats.size / 1024).toFixed(1);
    const sizeStr = stats.size > 1024 * 1024 
      ? `${(stats.size / (1024 * 1024)).toFixed(2)} MB` 
      : `${sizeInKb} KB`;

    const cleanTitle = file
      .replace(/\.pdf$/i, '')
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (char) => char.toUpperCase());

    const fileUrl = `${base}/study-files/${domain}/${file}`;
    const viewerUrl = `${base}/pdfjs/web/viewer.html?file=${encodeURIComponent(fileUrl)}#view=FitH`;
    
    // Direct Hypothesis Via viewer: bypasses third-party cookie restrictions in browsers
    const fullPublicPdfUrl = `https://jrayas.github.io${base}/study-files/${domain}/${encodeURIComponent(file)}`;
    const hypothesisUrl = `https://via.hypothes.is/${fullPublicPdfUrl}`;

    return {
      name: file,
      title: cleanTitle,
      size: sizeStr,
      url: fileUrl,
      viewerUrl,
      hypothesisUrl,
    };
  });
}
---

<div class="pub-wrapper">
  {files.length === 0 ? (
    <p class="pub-empty">No documents found.</p>
  ) : (
    <div class="pub-list">
      {files.map((pdf) => (
        <div class="pub-item">
          <div class="pub-title-col">
            <a 
              href={pdf.hypothesisUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="pub-title-link"
              title="Annotate with Hypothesis"
            >
              {pdf.title}
            </a>
          </div>

          <div class="pub-meta-actions">
            <span class="pub-size">{pdf.size}</span>
            <span class="pub-sep">/</span>
            <a 
              href={pdf.hypothesisUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="pub-action-link pub-accent-link"
              title="Open with Hypothesis (Direct viewer, no third-party cookie issues)"
            >
              Annotate ↗
            </a>
            <span class="pub-sep">·</span>
            <a 
              href={pdf.viewerUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="pub-action-link"
              title="Open in local PDF.js viewer"
            >
              Read ↗
            </a>
            <span class="pub-sep">·</span>
            <a 
              href={pdf.url} 
              download 
              class="pub-action-link"
              title="Download PDF"
            >
              Download
            </a>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .pub-wrapper {
    margin: 2rem 0;
  }

  .pub-empty {
    padding: 2rem 0;
    color: var(--sl-color-gray-3);
  }

  .pub-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .pub-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
    gap: 1.5rem;
    flex-wrap: wrap;
    transition: background 0.15s ease;
  }

  .pub-title-col {
    flex: 1;
    min-width: 250px;
  }

  .pub-title-link {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--sl-color-text) !important;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--sl-color-hairline);
    transition: all 0.15s ease;
  }

  .pub-title-link:hover {
    color: var(--sl-color-accent) !important;
    text-decoration-color: var(--sl-color-accent) !important;
  }

  .pub-meta-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .pub-size {
    color: var(--sl-color-gray-3);
    font-family: monospace;
    font-size: 0.8rem;
  }

  .pub-sep {
    color: var(--sl-color-hairline);
  }

  .pub-action-link {
    color: var(--sl-color-text) !important;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .pub-accent-link {
    color: var(--sl-color-accent) !important;
    font-weight: 600;
  }

  .pub-action-link:hover {
    color: var(--sl-color-accent) !important;
  }
</style>
